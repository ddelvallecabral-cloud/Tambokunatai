# Copiá este archivo como .env y cambiá los valores marcados.

# --- Django ---
# OBLIGATORIO cambiar en producción. Generá uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria-de-50-caracteres
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
# En producción con HTTPS poné True para que la cookie de sesión solo viaje cifrada.
COOKIE_SECURE=False
LOG_LEVEL=INFO

# --- Sesión ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOGIN_THROTTLE=30/min
# Tras esta cantidad de claves mal seguidas, ese usuario espera estos minutos (0 = sin bloqueo).
LOGIN_FALLOS_MAX=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Leche ---
# Valor inicial de la alerta de producción baja: un día completo (mañana + tarde) por debajo de estos litros.
# Después se cambia desde el sistema (Reportes → Alertas).
LECHE_UMBRAL_LITROS_DIARIOS=250

# --- Queso ---
# Rango inicial de rendimiento esperado en litros de leche por kg de queso (después, Reportes → Alertas).
QUESO_RENDIMIENTO_MIN_L_KG=7
QUESO_RENDIMIENTO_MAX_L_KG=11

# Gastos: por encima de este monto (Gs.) quedan pendientes de aprobación del Administrador
GASTO_MONTO_APROBACION=500000
# Tamaño máximo de la foto o PDF del comprobante (MB)
COMPROBANTE_MAX_MB=8

# --- Base de datos ---
POSTGRES_DB=tambo
POSTGRES_USER=tambo
POSTGRES_PASSWORD=tambo
# Solo para correr el backend fuera de Docker (en Docker se arma solo):
DATABASE_URL=postgres://tambo:tambo@localhost:5432/tambo

# --- Datos de prueba ---
# 1 = al arrancar crea el establecimiento y los usuarios admin / operador / ventas.
SEED_DEMO=1
SEED_CLAVE_ADMIN=Tambo.Admin2026
SEED_CLAVE_OPERADOR=Tambo.Operador2026
SEED_CLAVE_VENTAS=Tambo.Ventas2026

# --- Producción (solo con docker-compose.prod.yml; ver DESPLIEGUE.md) ---
# Dominio del sistema, sin https:// (Caddy pide el certificado HTTPS para este nombre).
# DOMINIO=tambo.midominio.com.py
# Respaldos: carpeta, días que se guardan y destino de rclone para copiarlos fuera del servidor.
# RESPALDO_DIR=respaldos
# RESPALDO_DIAS=30
# RESPALDO_REMOTO=drive:respaldos-tambo
